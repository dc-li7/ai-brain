#!/usr/bin/env python3
"""memory-index: rebuild each Memory/<scope>/MEMORY.md from the memory files.

Each machine used to keep the index its own way: one appended lines by hand
(and drifted from the files), the other re-sorted the whole file by a score
that changes with the date and usage counts. git merges the index with
merge=union, so syncs never stopped, but every reshuffle met against an edit
from the other machine left both versions of the line: the index slowly filled
with duplicates and lines for deleted memories.

This version sorts by things stored in the files only (pinned, type, topic,
file name), so every machine builds the same index from the same files.
brain-sync runs it before each commit and again after each rebase.

Tree mode (added 2026-11-02). A flat index of every memory outgrew the space
an AI loads at the start of a session (main hit ~17 KB). A scope that has a
TOPICS.md gets:
  - a small MEMORY.md: the pinned memories, then one line per top-level topic
    with its summary and memory count;
  - one generated file per topic under index/ (index/work.md, with
    sub-topics nesting as index/work/clients.md), listing that topic's
    sub-topics and memories, one line each.
A memory names its topic with `topic: <slug>` under `metadata:`. Memories with
no topic (or an unknown or malformed one) are still listed, under Unsorted, so
nothing disappears from the index. Scopes without a TOPICS.md keep the flat
index, unchanged.

MEMORY.md itself is always rebuilt, in both modes, as it always was; it says
so in its header. Generated files under index/ start with MARKER. Only files that carry it are
ever overwritten or deleted, so a hand-written file placed there is safe.
Topic slugs are checked against SLUG_RE before they become paths, so a topic
can never write outside index/.

Usage: memory-index [--check]   (--check = report what would change, write nothing)
Exit codes: 0 ok, 1 a file could not be read or written.
Notes (unsorted memories, unknown topics, topics worth splitting) go to stderr
and do not change the exit code.
"""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

BRAIN = Path(os.environ.get("BRAIN_DIR", Path.home() / "Mind"))
TOPICS_FILE = "TOPICS.md"
NON_MEMORY = {"MEMORY.md", "README.md", TOPICS_FILE}
TYPE_ORDER = ["user", "feedback", "project", "reference"]
# Files with these words in the name count as pinned unless their frontmatter
# says otherwise (pinned: true/false). Add your own core-rule file names here.
PIN_HINTS = ("sudo", "secret", "user_profile", "user-profile")
# Claude only loads the start of MEMORY.md, so keep each line short.
MAX_DESC = 200

INDEX_DIR = "index"
MARKER = "<!-- generated by memory-index: do not edit; rebuilt from the memory files and TOPICS.md -->"
# Lowercase segments, at most 3 levels: "work", "work/clients", "home/network/vpn".
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*){0,2}$")
UNSORTED = "unsorted"
UNSORTED_SUMMARY = "Memories with no topic yet; give each one a topic from TOPICS.md"
SPLIT_AT = 25  # a topic listing more memories than this is worth splitting
UNSORTED_SHOWN = 20  # no-topic memories listed directly in MEMORY.md; the rest only in index/unsorted.md

HEADER = (
    "# Memory Index\n\n"
    "_Built from the memory files by AI/setup/memory-index on every brain-sync. "
    "★ = pinned. Lines added by hand are fine; the next sync rebuilds them from the files._\n"
)

TREE_HEADER = (
    "# Memory Index\n\n"
    "_Built by AI/setup/memory-index on every brain-sync; don't edit by hand. "
    "This index is a tree: the pinned memories (★) are below, then one line per topic. "
    "Open a topic file (index/…) to see its memories, one line each, and its sub-topics. "
    "To file a new memory, put `topic: <slug>` under `metadata:` in its frontmatter "
    "(the topic list is TOPICS.md); without one it is listed under \"No topic yet\" below. "
    "Searching the memory folder finds any memory directly._\n"
)


def unquote(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] == '"':
        try:
            return json.loads(value)  # JSON escapes cover what the memory files use
        except json.JSONDecodeError:
            return value[1:-1]
    if len(value) >= 2 and value[0] == value[-1] == "'":
        return value[1:-1].replace("''", "'")
    return value


def frontmatter(path: Path) -> dict:
    """Read the few flat fields the index needs. Deliberately not a YAML parser:
    a machine's system python may not have PyYAML, and a missing library must
    not give the two machines different indexes. Nested keys (under metadata:)
    land in fm["metadata"]."""
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    raw: dict = {}
    meta: dict = {}
    last = None  # top-level key whose value may continue on indented lines
    for line in lines[1:]:
        if line.strip() == "---":
            fm = {k: unquote(v) for k, v in raw.items()}
            fm["metadata"] = {k: unquote(v) for k, v in meta.items()}
            return fm
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indented = line[0] in " \t"
        if indented and last is not None:
            # A long value wrapped onto the next lines, or a `>` / `|` block.
            raw[last] = (raw[last] + " " + line.strip()).strip()
            continue
        key, sep, value = line.strip().partition(":")
        if not sep:
            continue
        key, value = key.strip(), value.strip()
        if indented:
            meta[key] = value
            last = None
        else:
            raw[key] = "" if value in (">", ">-", ">+", "|", "|-", "|+") else value
            # metadata: opens the nested block; any other key may wrap onto the next lines.
            last = None if key == "metadata" else key
    raise ValueError("frontmatter has no closing ---")


def field(fm: dict, key: str):
    # Fields may be nested under metadata: or flat at the top.
    meta = fm.get("metadata") if isinstance(fm.get("metadata"), dict) else {}
    return meta.get(key, fm.get(key))


def is_pinned(fm: dict, path: Path) -> bool:
    v = field(fm, "pinned")
    if isinstance(v, str):
        return v.strip().lower() in ("true", "yes", "1")
    return any(h in path.stem.lower() for h in PIN_HINTS)


def one_line(desc: str) -> str:
    desc = " ".join(str(desc).split()).rstrip(".")
    if len(desc) > MAX_DESC:
        desc = desc[: MAX_DESC - 1].rstrip() + "…"
    return desc


def collect(scope: Path, errors: list[str]) -> list[dict]:
    """Every memory file in the scope, with what the index needs to know about it."""
    items = []
    for p in sorted(scope.glob("*.md")):
        if p.name in NON_MEMORY:
            continue
        if p.is_symlink():
            # A memory is a plain file. A link could point anywhere on the machine.
            errors.append(f"{scope.name}/{p.name}: is a symlink, not listed")
            continue
        try:
            fm = frontmatter(p)
        except ValueError as e:  # includes UnicodeDecodeError
            # Still list the file so it stays findable; the caller reports the error.
            errors.append(f"{scope.name}/{p.name}: {e}")
            fm = {"description": "(frontmatter unreadable, fix this file)"}
        mtype = str(field(fm, "type") or "other").lower()
        items.append({
            "path": p,
            "pinned": is_pinned(fm, p),
            "type": mtype if mtype in TYPE_ORDER else "other",
            "topic": str(field(fm, "topic") or "").strip(),
            "desc": one_line(fm.get("description") or fm.get("name") or p.stem),
        })
    return items


def line_for(item: dict, link_prefix: str = "") -> str:
    star = "★ " if item["pinned"] else ""
    name = item["path"].name
    return f"- {star}[{name}]({link_prefix}{name}) — {item['desc']}"


def build_flat(scope: Path, errors: list[str]) -> str:
    groups: dict[str, list[str]] = {}
    for item in collect(scope, errors):
        key = "pinned" if item["pinned"] else item["type"]
        groups.setdefault(key, []).append(line_for(item))
    out = [HEADER]
    for key in ["pinned", *TYPE_ORDER, "other"]:
        if groups.get(key):
            out.append(f"\n## {key.capitalize()}\n")
            out.extend(line + "\n" for line in groups[key])
    return "".join(out)


def read_topics(path: Path, notes: list[str]) -> dict[str, str]:
    """TOPICS.md lines of the form `- slug: summary`, in file order."""
    topics: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.startswith("- "):
            continue
        slug, sep, summary = line[2:].partition(":")
        slug = slug.strip()
        if not sep or not SLUG_RE.match(slug):
            notes.append(f"{path.parent.name}/{TOPICS_FILE}: skipped line, bad topic slug: {line[:60]!r}")
            continue
        topics[slug] = " ".join(summary.split()).rstrip(".")
    return topics


def add_with_parents(topics: dict[str, str], slug: str) -> None:
    parts = slug.split("/")
    for i in range(1, len(parts) + 1):
        topics.setdefault("/".join(parts[:i]), "")


def sort_key(item: dict):
    return (not item["pinned"], TYPE_ORDER.index(item["type"]) if item["type"] in TYPE_ORDER else 9,
            item["path"].name)


def build_tree(scope: Path, errors: list[str], notes: list[str]) -> dict[str, str]:
    """Return {path relative to the scope: content} for MEMORY.md and every index file."""
    topics = read_topics(scope / TOPICS_FILE, notes)
    for slug in list(topics):
        add_with_parents(topics, slug)  # "a/b" listed alone still gets an "a" level
    items = collect(scope, errors)

    by_topic: dict[str, list[dict]] = {}
    for item in items:
        t = item["topic"]
        if t and not SLUG_RE.match(t):
            notes.append(f"{scope.name}/{item['path'].name}: bad topic {t!r}, listed under {UNSORTED}")
            t = ""
        if t and t not in topics:
            notes.append(f"{scope.name}/{item['path'].name}: topic {t!r} is not in {TOPICS_FILE}; "
                         f"listed anyway (add a summary line for it)")
            add_with_parents(topics, t)
        by_topic.setdefault(t or UNSORTED, []).append(item)

    if by_topic.get(UNSORTED):
        notes.append(f"{scope.name}: {len(by_topic[UNSORTED])} memories have no topic "
                     f"(see {INDEX_DIR}/{UNSORTED}.md)")
        topics[UNSORTED] = UNSORTED_SUMMARY
    elif UNSORTED in topics:
        del topics[UNSORTED]

    def children(slug: str) -> list[str]:
        depth = slug.count("/") + 1
        return [t for t in topics if t.startswith(slug + "/") and t.count("/") == depth]

    def total(slug: str) -> int:
        return len(by_topic.get(slug, [])) + sum(total(c) for c in children(slug))

    def summary_text(slug: str) -> str:
        return topics.get(slug) or "(no summary yet: add one to TOPICS.md)"

    def topic_line(slug: str, link: str) -> str:
        kids = children(slug)
        sub = f" · sub-topics: {', '.join(k.rsplit('/', 1)[-1] for k in kids)}" if kids else ""
        return f"- [{slug}]({link}) — {summary_text(slug)} ({total(slug)}){sub}"

    files: dict[str, str] = {}

    # Top: pinned memories (whatever their topic), then the top-level topics.
    out = [TREE_HEADER]
    pinned = sorted((i for i in items if i["pinned"]), key=sort_key)
    if pinned:
        out.append("\n## Pinned\n")
        out.extend(line_for(i) + "\n" for i in pinned)
    out.append("\n## Topics\n")
    for slug in [t for t in topics if "/" not in t and t != UNSORTED]:
        out.append(topic_line(slug, f"{INDEX_DIR}/{slug}.md") + "\n")
    # Memories with no topic are listed right here, so a brand-new memory is
    # visible at the start of the next session until someone files it.
    loose = sorted(by_topic.get(UNSORTED, []), key=sort_key)
    if loose:
        out.append(f"\n## No topic yet ({len(loose)})\n")
        out.extend(line_for(i) + "\n" for i in loose[:UNSORTED_SHOWN])
        if len(loose) > UNSORTED_SHOWN:
            out.append(f"- …and {len(loose) - UNSORTED_SHOWN} more: [{UNSORTED}]({INDEX_DIR}/{UNSORTED}.md)\n")
    files["MEMORY.md"] = "".join(out)

    # One file per topic. index/<slug>.md, so "work/clients" lives at index/work/clients.md.
    for slug in topics:
        depth = slug.count("/") + 1          # folders between the scope root and this file
        to_root = "../" * depth
        leaf = slug.rsplit("/", 1)[-1]
        if "/" in slug:
            parent = slug.rsplit("/", 1)[0]
            up = f"[{parent}](../{parent.rsplit('/', 1)[-1]}.md)"
        else:
            up = f"[Memory index]({to_root}MEMORY.md)"
        out = [MARKER + "\n", f"# {slug}\n\n",
               f"_{summary_text(slug)}. Up: {up}. Built by memory-index from TOPICS.md and the "
               f"memories' `topic:` lines; don't edit this file._\n"]
        kids = children(slug)
        if kids:
            out.append("\n## Sub-topics\n")
            out.extend(topic_line(k, f"{leaf}/{k.rsplit('/', 1)[-1]}.md") + "\n" for k in kids)
        mine = sorted(by_topic.get(slug, []), key=sort_key)
        if mine:
            out.append("\n## Memories\n")
            out.extend(line_for(i, to_root) + "\n" for i in mine)
            if len(mine) > SPLIT_AT:
                out.append(f"\n_More than {SPLIT_AT} memories here: worth splitting into sub-topics in TOPICS.md._\n")
                notes.append(f"{scope.name}: topic {slug!r} lists {len(mine)} memories; consider sub-topics")
        if not kids and not mine:
            out.append("\n_No memories in this topic yet._\n")
        files[f"{INDEX_DIR}/{slug}.md"] = "".join(out)
    return files


def is_generated(path: Path) -> bool:
    try:
        with path.open(encoding="utf-8") as f:
            return f.readline().rstrip("\n") == MARKER
    except (OSError, UnicodeDecodeError):
        return False


def write_tree(scope: Path, files: dict[str, str], check: bool, errors: list[str]) -> None:
    index = scope / INDEX_DIR
    if index.is_symlink():
        errors.append(f"{scope.name}/{INDEX_DIR}: is a symlink, tree not written")
        return
    root = scope.resolve()
    wanted = set()
    for rel, new in files.items():
        target = scope / rel
        wanted.add(target)
        # Belt and braces on top of SLUG_RE: no link anywhere between the scope
        # folder and the file (a linked folder could point anywhere), and the
        # result must still sit inside the scope folder.
        cur, linked = scope, False
        for part in Path(rel).parts:
            cur = cur / part
            linked = linked or cur.is_symlink()
        if linked:
            errors.append(f"{scope.name}/{rel}: path has a symlink, not written")
            continue
        if root not in target.resolve().parents:
            errors.append(f"{scope.name}/{rel}: outside the scope folder, not written")
            continue
        if rel != "MEMORY.md" and target.exists() and not is_generated(target):
            errors.append(f"{scope.name}/{rel}: exists and was not made by memory-index, not overwritten")
            continue
        old = target.read_text(encoding="utf-8") if target.exists() else ""
        if new == old:
            continue
        if check:
            print(f"would rebuild {target}")
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(new, encoding="utf-8")
        print(f"rebuilt {target} ({new.count(chr(10))} lines, {len(new.encode())} bytes)")

    # Topic files for topics that no longer exist. Only generated files are removed.
    if index.is_dir():
        # os.walk with followlinks=False: never descend into a linked folder.
        found, dirs = [], []
        for dirpath, dirnames, filenames in os.walk(index, followlinks=False):
            dirs.append(Path(dirpath))
            found.extend(Path(dirpath) / f for f in filenames if f.endswith(".md"))
        for p in sorted(found, reverse=True):
            if p in wanted or p.is_symlink() or not is_generated(p):
                continue
            if check:
                print(f"would delete {p}")
            else:
                p.unlink()
                print(f"deleted {p} (topic gone)")
        if not check:
            for d in sorted(dirs, reverse=True):
                if d == index or d.is_symlink():
                    continue
                try:
                    d.rmdir()  # only succeeds when empty
                except OSError:
                    pass


def main() -> int:
    check = "--check" in sys.argv[1:]
    memory = BRAIN / "Memory"
    if not memory.is_dir():
        print(f"memory-index: {memory} not found", file=sys.stderr)
        return 1
    errors: list[str] = []
    notes: list[str] = []
    for scope in sorted(d for d in memory.iterdir() if d.is_dir() and not d.name.startswith(".")):
        target = scope / "MEMORY.md"
        if target.is_symlink():
            # Writing through a planted link would overwrite whatever it points at.
            errors.append(f"{scope.name}/MEMORY.md: is a symlink, not rebuilt")
            continue
        # A scope whose memories were all deleted still gets rebuilt (to an empty index).
        if not target.exists() and not any(p.name not in NON_MEMORY for p in scope.glob("*.md")):
            continue
        try:
            topics_file = scope / TOPICS_FILE
            if topics_file.is_file() and not topics_file.is_symlink():
                write_tree(scope, build_tree(scope, errors, notes), check, errors)
                continue
            new = build_flat(scope, errors)
            old = target.read_text(encoding="utf-8") if target.exists() else ""
            if new == old:
                continue
            if check:
                print(f"would rebuild {target}")
            else:
                target.write_text(new, encoding="utf-8")
                print(f"rebuilt {target} ({new.count(chr(10))} lines, {len(new.encode())} bytes)")
        except (OSError, UnicodeDecodeError) as e:
            # An unreadable index file (permissions, broken encoding) is reported, never a crash.
            errors.append(f"{scope.name}: {e}")
    for note in notes:
        print(f"memory-index: note: {note}", file=sys.stderr)
    for err in errors:
        print(f"memory-index: {err}", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
